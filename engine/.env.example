# ==============================================================================
# CREDENCIAIS DO LEAD RECON ENGINE
# Copie este arquivo como engine/.env. Cada bloco traz o link direto da página
# onde o valor é obtido. O dashboard mostra o estado de cada integração na tela
# "Integrações", com os mesmos links.
# ==============================================================================

# ------------------------------------------------------------------------------
# MODO DEMONSTRAÇÃO
#   false (padrão) → só dados reais. Integração com problema aparece como erro,
#                    com o link para corrigir — nunca é trocada por dado fictício.
#   true           → integrações indisponíveis usam dados simulados, sinalizados.
# ------------------------------------------------------------------------------
ALLOW_SIMULATED_DATA=false

# ------------------------------------------------------------------------------
# CV CRM (Construtor de Vendas)
#   Token e permissões: https://SUAEMPRESA.cvcrm.com.br/gestor
#   Documentação:       https://desenvolvedor.cvcrm.com.br/reference
#   CV_CRM_EMAIL é obrigatório para ler leads (e-mail do usuário dono do token).
#   Para ler vendas, o token precisa da permissão de Reservas habilitada.
# ------------------------------------------------------------------------------
CV_CRM_URL="https://suaempresa.cvcrm.com.br"
CV_CRM_EMAIL="usuario.do.token@suaempresa.com.br"
CV_CRM_TOKEN="seu_token_cv_aqui"
# Dias de histórico do CV usados para achar cada lead no CRM (padrão 365)
# CV_LOOKBACK_DAYS=365

# ------------------------------------------------------------------------------
# BEEVIRAL (indicações)
#   Chave de API: https://account.beeviral.app/
# ------------------------------------------------------------------------------
BEEVIRAL_API_KEY="sua_chave_beeviral_aqui"

# ------------------------------------------------------------------------------
# META ADS (Facebook / Instagram Lead Ads)
#   Token permanente (Usuário do sistema): https://business.facebook.com/settings/system-users
#     permissões: leads_retrieval, pages_show_list, pages_read_engagement
#   Validar token:     https://developers.facebook.com/tools/debug/accesstoken/
#   Graph API Explorer: https://developers.facebook.com/tools/explorer/
# ------------------------------------------------------------------------------
META_ACCESS_TOKEN="seu_token_meta_ads_aqui"
META_PAGE_ID="id_da_pagina_do_facebook"
# Contas de anúncio (uma por empreendimento), separadas por vírgula. Vazio = todas as
# contas que o token enxerga. O ID aparece em Configurações de pagamento ou no Gerenciador.
META_AD_ACCOUNT_IDS=""
# META_GRAPH_VERSION="v23.0"

# ------------------------------------------------------------------------------
# GOOGLE ANALYTICS 4 (palavras buscadas por praça)
#   ID da propriedade:  Administrador -> Detalhes da propriedade (só números)
#   Conta de serviço:   https://console.cloud.google.com/iam-admin/serviceaccounts
#                       depois dê acesso de leitura ao e-mail dela em
#                       Administrador -> Acesso à propriedade
# ------------------------------------------------------------------------------
GA4_PROPERTY_IDS=""
GA4_CREDENTIALS_PATH=""
# Alternativa à conta de serviço: OAuth do próprio usuário (escopo analytics.readonly).
# Sem estes, valem os do Google Ads.
# GA4_CLIENT_ID=""
# GA4_CLIENT_SECRET=""
# GA4_REFRESH_TOKEN=""

# ------------------------------------------------------------------------------
# RD STATION MARKETING (OAuth2 — o access token expira em 24h)
#   Criar app (client_id / client_secret): https://appstore.rdstation.com/pt-BR/publisher
#   Documentação:                          https://developers.rdstation.com/reference/introducao-rdsm
#   Com CLIENT_ID + CLIENT_SECRET + REFRESH_TOKEN o token é renovado sozinho.
# ------------------------------------------------------------------------------
RD_STATION_CLIENT_ID=""
RD_STATION_CLIENT_SECRET=""
RD_STATION_REFRESH_TOKEN=""
# Opcional: access token direto (expira em 24h) e segmentação a ler
RD_STATION_API_TOKEN=""
RD_STATION_SEGMENTATION_ID=""

# ------------------------------------------------------------------------------
# GOOGLE ADS (formulários de lead)
#   ATENÇÃO: o developer token foi descontinuado em 09/09/2026. O nível de acesso agora é do
#   projeto no Google Cloud: console.cloud.google.com/google/ads-apis/overview (precisa de
#   Explorer ou superior para ler contas de produção; "Conta de teste" só lê contas de teste).
#   Credencial: conta de serviço (GOOGLE_ADS_CREDENTIALS_PATH, com o e-mail dela liberado em
#   Adm. > Acesso e segurança no Google Ads) ou OAuth de usuário (client id/secret/refresh token).
#   Developer token (histórico):  https://ads.google.com/aw/apicenter
#   Client ID OAuth:      https://console.cloud.google.com/apis/credentials
#   Refresh token:        https://developers.google.com/oauthplayground/
#   Guia:                 https://developers.google.com/google-ads/api/docs/first-call/overview
#   CUSTOMER_ID é o número da conta de anúncios (sem traços), no topo do Google Ads.
#   LOGIN_CUSTOMER_ID só é necessário quando o acesso é por conta MCC.
# ------------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN="seu_developer_token_google_ads"
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
# Contas por empreendimento, separadas por vírgula (sem traços). Com LOGIN_CUSTOMER_ID de uma
# MCC e esta variável vazia, as contas da MCC são descobertas automaticamente.
GOOGLE_ADS_CUSTOMER_IDS=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# GOOGLE_ADS_API_VERSION="v25"

# ------------------------------------------------------------------------------
# PLANILHAS (opcionais)
#   SALES_FILE_PATH:     base de vendas usada quando as reservas do CV não estão
#                        acessíveis (a planilha também pode ser carregada no dashboard)
#   SHEETS_BI_FILE_PATH: leads presenciais (estande, eventos) exportados do BI
# ------------------------------------------------------------------------------
SALES_FILE_PATH=""
SHEETS_BI_FILE_PATH=""

# ------------------------------------------------------------------------------
# FIREBASE (opcional — histórico na nuvem)
#   Chave do Admin SDK: https://console.firebase.google.com/  → Configurações do projeto → Contas de serviço
# ------------------------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=""

# ------------------------------------------------------------------------------
# BASES SALVAS (BI e conferências)
#   As bases ficam em output/bases e se atualizam sozinhas enquanto a API roda.
# ------------------------------------------------------------------------------
# BASES_AGENDADOR=true
# BASES_INTERVALO_MINUTOS=60
# BASES_MAX_IDADE_HORAS=1
# BASES_HISTORICO_DIAS=400
